# Copy to .env (gitignored). Run `just devices` to get both identifiers.

# xcodebuild -destination 'platform=iOS,id=...'  — the hardware UDID.
BUILD_ID=00008130-001A2B3C4D5E6F00

# devicectl --device ...  — the CoreDevice UUID from the Identifier column.
# Different value for the same phone. This is not a typo.
DEVICE_ID=A1B2C3D4-5E6F-7890-ABCD-EF1234567890

# Optional. Defaults to "iPhone 16". See `just sims`.
SIM=iPhone 16
